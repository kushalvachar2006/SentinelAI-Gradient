# Python FastAPI service
PORT=8000
DEBUG=false
WORKERS=1
NODE_SERVICE_URL=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sentinelai
MONGODB_DB=sentinelai

# Shared JWT secret with Node (must match!)
JWT_SECRET=changeme_in_production

# AI — set your Gemini API key to enable AI features
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional enrichment APIs
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=